# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1

# Domain Configuration
VERIFIED_DOMAIN=job2mada.com
SES_FROM_EMAIL=noreply@job2mada.com
SUPPORT_EMAIL=support@job2mada.com
# Frontend URL
FRONTEND_URL=https://job2mada.com

# Server Configuration
PORT=3002
NODE_ENV=production

VITE_EMAIL_API_URL=http://localhost:3002/api/send-message-notification
# Prod
# VITE_EMAIL_API_URL=https://api.job2mada.com/api/send-message-notification

# ===== EMAIL PROVIDERS (7 services gratuits) =====

# Brevo (ex-Sendinblue) - 300/jour
BREVO_API_KEY=

# Mailjet - 200/jour
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Resend - 100/jour
RESEND_API_KEY=

# SendGrid - 100/jour
SENDGRID_API_KEY=

# Mailersend - 100/jour
MAILERSEND_API_KEY=

# SMTP2GO - 33/jour
SMTP2GO_API_KEY=

# EmailJS - 200/jour (pas de pièces jointes)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Configuration générale
SENDER_EMAIL=noreply@job2mada.com
SENDER_NAME=Job2Mada
