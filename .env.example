

# --- Appwrite (front, préfixe VITE_) ---
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=job2mada-db
# Si le plan Appwrite est limité à 1 bucket : ID de ce bucket unique (voir scripts/appwrite/schema.mjs)
VITE_APPWRITE_SINGLE_BUCKET=images

# --- Appwrite (scripts serveur : npm run appwrite:setup / appwrite:seed) ---
# Clé API avec les scopes : databases.*, collections.*, attributes.*, indexes.*, documents.*, users.*, buckets.*, files.*
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=job2mada-db
APPWRITE_API_KEY=your_server_api_key
